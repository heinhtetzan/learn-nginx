// Ferron Sandbox Configuration (KDL)

server {
    // Disable auto TLS in local development sandbox
    auto_tls_disabled
}

site ":80" {
    root "/usr/share/ferron"

    // Reverse proxy to backend microservice
    route "/api/*" {
        proxy "http://backend:5678" {
            preserve_host true
        }
    }

    // Health check endpoint
    route "/healthz" {
        respond "healthy" 200
    }

    // Static assets & SPA fallback
    route "/*" {
        file_server
        try_files "$uri" "$uri/" "/index.html"
    }
}
